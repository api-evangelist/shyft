{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shyft Customer Authentication > Email Customer > Departments API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Customer > Departments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "get location inner departments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{{host}}/api/customer/user_role/locations/2806/inner_departments",
            "headers": [
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "docs": "get location inner departments"
        },
        {
          "info": {
            "name": "get mine departments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{{host}}/api/customer/user_role/departments/mine",
            "headers": [
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "docs": "get mine departments"
        },
        {
          "info": {
            "name": "create a new department",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{{host}}/api/customer/user_role/departments",
            "headers": [
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "docs": "create a new department"
        },
        {
          "info": {
            "name": "update a new department",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://{{host}}/api/customer/user_role/departments/1",
            "headers": [
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "docs": "update a new department"
        },
        {
          "info": {
            "name": "assign a department users",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://{{host}}/api/customer/user_role/departments/1/assign_users",
            "headers": [
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "response[put_return_resource]",
                "value": "true",
                "type": "query"
              }
            ]
          },
          "docs": "assign a department users"
        },
        {
          "info": {
            "name": "delete a department",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://{{host}}/api/customer/user_role/departments/2",
            "headers": [
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "docs": "delete a department"
        }
      ]
    }
  ],
  "bundled": true
}