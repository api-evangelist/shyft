{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shyft Customer Authentication > Email Customer > AdminClaims API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Customer > AdminClaims",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "claim admin by code",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{{host}}/api/customer/user_role/admin_claims/claim",
            "headers": [
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "activation_code",
                "value": "{{activation_code}}",
                "type": "query",
                "description": "the code got by email"
              }
            ]
          },
          "docs": "Input \n- - -\n\nAttribute | Values | M\n--- | --- | ---"
        },
        {
          "info": {
            "name": "create admin claim",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{{host}}/api/customer/user_role/admin_claims",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Session-Uukey",
                "value": "{{session_uukey}}"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Input \n- - -\n\nAttribute | Values | M\n--- | --- | ---\nemail | your email using for admin claim | Y  \nref_id | target location ID | Y\nemail_host | the host of the hyberlink inside the email | \n\nOutput \n- - -\n\nAttribute | Values |\n--- | --- \nid | recrod ID   \nsent_to | sent_to_shyft&#124;sent_to_user"
        }
      ]
    }
  ],
  "bundled": true
}