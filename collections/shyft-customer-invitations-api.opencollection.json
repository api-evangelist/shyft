              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "location_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Invite contacts"
        }
      ]
    }
  ],
  "bundled": true
}